<Window x:Class="DziennikGUI.OknoStudent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel Studenta" Height="550" Width="800" WindowStartupLocation="CenterScreen" Background="#FFEAECEF">

    <Grid Margin="20">
        <Border Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Color="#D0D0D0" Direction="270" ShadowDepth="3" Opacity="0.4"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*"/>
                         <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                         <TextBlock x:Name="txtPowitanie" Text="Witaj, Studencie!" FontSize="24" FontWeight="Bold" Foreground="#333"/>
                         <TextBlock x:Name="txtNumeralbumu" Text="Nr albumu: ---" FontSize="14" Foreground="Gray" Margin="0,5,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="txtData" Grid.Column="1" Text="Data" FontSize="12" Foreground="#999" VerticalAlignment="Center"/>
                </Grid>

                <Separator Grid.Row="1" Background="#EEE" Margin="0,0,0,15"/>

                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="Twoje Oceny" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#444"/>
                    <Border Background="#F9F9F9" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1">
                        <ListBox x:Name="listaOcen" BorderThickness="0" Background="Transparent" Padding="10"/>
                    </Border>
                </DockPanel>

                <Button Grid.Row="3" Content="Wyloguj" Click="BtnWyloguj_Click" 
                        Height="35" Width="100" HorizontalAlignment="Right" Margin="0,20,0,0"
                        Style="{StaticResource BtnDanger}"/>

            </Grid>
        </Border>
    </Grid>
</Window>