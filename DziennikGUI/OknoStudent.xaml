<Window x:Class="DziennikGUI.OknoStudent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel Studenta" Height="400" Width="500" WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtPowitanie" Text="Witaj, Studencie!" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

        <ListBox x:Name="listaOcen" Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="#FAFAFA" Margin="0,0,0,15"/>

        <Button Grid.Row="2" Content="Wyloguj" Click="BtnWyloguj_Click" 
                Height="40" Background="#FFDDDD" FontWeight="SemiBold"/>
        <TextBlock x:Name="txtNumeralbumu" TextWrapping="Wrap" Text="TextBlock" Margin="0,-8,315,28" FontSize="12"/>
        <TextBlock x:Name="txtData" TextWrapping="Wrap" Text="TextBlock" Margin="315,-8,0,28" FontSize="12" TextAlignment="Right"/>

    </Grid>
</Window>