<Window x:Class="DziennikGUI.OknoDziekanat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elektroniczny Dziennik Uczelniany" Height="500" Width="600">

    <TabControl Margin="5">

        <TabItem Header="Studenci">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Nowy Student" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Label Content="Imię:"/>
                    <TextBox x:Name="txtImie" Padding="3"/>

                    <Label Content="Nazwisko:"/>
                    <TextBox x:Name="txtNazwisko" Padding="3"/>

                    <Label Content="PESEL:"/>
                    <TextBox x:Name="txtPesel" Padding="3"/>

                    <Button Content="Dodaj Studenta" Click="ButtonDodaj_Click" Margin="0,15" Padding="5" Background="#DDDDDD"/>

                    <ComboBox x:Name="cmbKierunkow" Margin="0,15" Padding="5"/>
                    <Button Content="Przypisz do kierunku" Margin="0,15" Padding="5" Background="#DDDDDD"/>
                    
                    <Button Content="Generuj Raport o studencie" Margin="0,15" Padding="5" Background="#DDDDDD" Click="ButtonGenerujRaport_Click"/>
                </StackPanel>

                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Text="Baza studentów:" FontWeight="SemiBold"/>
                    <ListBox x:Name="listaStudentow" Margin="0,5,0,0"/>
                </DockPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Prowadzący">
        </TabItem>

        <TabItem Header="Kierunki">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Dane Kierunku" Grid.Row="0" Padding="5">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Nazwa kierunku:"/>
                        <TextBox Width="440" Margin="5,0" x:Name="txtNazwaKierunku"/>
                    </StackPanel>
                </GroupBox>

                <Grid Grid.Row="1" Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" LastChildFill="True">
                        <Label Content="Lista Semestrów" DockPanel.Dock="Top" FontWeight="Bold"/>
                        <Button Content="Dodaj Semestr" DockPanel.Dock="Bottom" Height="30" Click="ButtonDodajSemestr_Click"/>

                        <ListBox x:Name="listaSemestrow"
             Margin="0,0,5,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Numer, StringFormat='Semestr {0}'}" FontWeight="Bold"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GroupBox Header="Szczegóły Semestru" Grid.Column="1" 
          DataContext="{Binding WybranySemestr}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
                                <GroupBox Header="Dane nowego semestru">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5" Width="250">
                                            <Label Content="Rok Akademicki:" Width="100"/>
                                            <TextBox x:Name="txtRokAkademicki" Width="150"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5" Width="250">
                                            <Label Content="Typ semestru:" Width="100"/>
                                            <ComboBox x:Name="cmbTypSemestru" Width="150"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <GroupBox Grid.Row="1" Header="Dodaj przedmiot do tego semestru" Margin="0,0,0,10">
                                <StackPanel Margin="5">
                                    <StackPanel Orientation="Horizontal" Margin="0,2" Width="250">
                                        <Label Content="Nazwa:" Width="80"/>
                                        <TextBox x:Name="txtNazwaPrzedmiotu" Width="170"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2" Width="250">
                                        <Label Content="ECTS:" Width="80"/>
                                        <TextBox x:Name="txtEcts" Width="50"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2" Width="250">
                                        <Label Content="Prowadzący:" Width="80"/>
                                        <ComboBox x:Name="cmbProwadzacy" Width="170" DisplayMemberPath="Nazwisko"/>
                                    </StackPanel>

                                    <Button Content="Dodaj Przedmiot do Listy" 
                    Click="ButtonDodajPrzedmiot_Click" 
                    Width="170" HorizontalAlignment="Left" Margin="80,10,3,3"/>
                                </StackPanel>
                            </GroupBox>

                            <DockPanel Grid.Row="2">
                                <Label Content="Lista przedmiotów w tym semestrze:" DockPanel.Dock="Top" FontWeight="Bold"/>
                                <ListBox x:Name="listaPrzedmiotow" Margin="0,5">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Nazwa}" FontWeight="Bold" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Ects, StringFormat='(ECTS: {0})'}" FontStyle="Italic"/>
                                                <TextBlock Text=" - "/>
                                                <TextBlock Text="{Binding Prowadzacy.Nazwisko}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <Button Grid.Row="3" Content="Zapisz ten Semestr w Kierunku" 
            Click="ButtonDodajSemestr_Click" 
            Height="30" Margin="0,10,0,0" Background="LightGray"/>
                        </Grid>
                    </GroupBox>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnAnulujKierunek" Content="Anuluj" Width="100" Height="30" Margin="5"/>
                    <Button x:Name="btnZapiszKierunek" Content="Zapisz Kierunek" Width="100" Height="30" Margin="5" Click="Button_ZapiszKierunek_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>