<Window x:Class="DziennikGUI.OknoDziekanat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elektroniczny Dziennik Uczelniany" Height="500" Width="600">

    <TabControl Margin="5">

        <TabItem Header="Studenci">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Nowy Student" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Label Content="Imię:"/>
                    <TextBox x:Name="txtImie" Padding="3"/>

                    <Label Content="Nazwisko:"/>
                    <TextBox x:Name="txtNazwisko" Padding="3"/>

                    <Label Content="PESEL:"/>
                    <TextBox x:Name="txtPesel" Padding="3"/>

                    <Button Content="Dodaj Studenta" Click="ButtonDodaj_Click" Margin="0,15" Padding="5" Background="#DDDDDD"/>

                    <ComboBox x:Name="cmbKierunkow" Margin="0,15" Padding="5"/>
                    <Button Content="Przypisz do kierunku"  Click="btnPrzypisz_Click" Margin="0,15" Padding="5" Background="#DDDDDD" />
                </StackPanel>

                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Text="Baza studentów:" FontWeight="SemiBold"/>
                    <ListBox x:Name="listaStudentow" Margin="0,5,0,0" SelectionChanged="listaStudentow_SelectionChanged"/>
                </DockPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Prowadzący">
        </TabItem>

        <TabItem Header="Kierunki">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Dane Kierunku" Grid.Row="0" Padding="5">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Nazwa kierunku:"/>
                        <TextBox Width="440" Margin="5,0" x:Name="txtNazwaKierunku" TextChanged="txtNazwaKierunku_TextChanged"/>
                    </StackPanel>
                </GroupBox>

                <Grid Grid.Row="1" Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" LastChildFill="True">
                        <Label Content="Lista Semestrów" DockPanel.Dock="Top" FontWeight="Bold"/>
                        <Button Content="Dodaj Semestr" DockPanel.Dock="Bottom" Height="30" Click="Button_DodajSemestrClick"/>

                        <ListBox x:Name="listaSemestrow"
             Margin="0,0,5,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Numer, StringFormat='Semestr {0}'}" FontWeight="Bold"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GroupBox Header="Szczegóły Semestru" Grid.Column="1" 
          DataContext="{Binding WybranySemestr}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="5">
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Label Content="Rok Akademicki:" Width="100"/>
                                    <TextBox x:Name="txtRokAkademicki" Width="150"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Label Content="Rodzaj:" Width="100"/>
                                    <ComboBox x:Name="cmbTypSemestru" Width="150">
                                        <ComboBoxItem x:Name="Z" >Zimowy</ComboBoxItem>
                                        <ComboBoxItem x:Name="L">Letni</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <DockPanel Grid.Row="1" Margin="0,10,0,0">
                                <Label Content="Przedmioty w semestrze:" DockPanel.Dock="Top" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" HorizontalAlignment="Right">
                                    <Button Content="Usuń Przedmiot" Margin="5"/>
                                    <Button Content="Dodaj Przedmiot" Margin="5"/>
                                </StackPanel>

                                <DataGrid ItemsSource="{Binding Przedmioty}" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nazwa Przedmiotu" Binding="{Binding Nazwa}" Width="*"/>
                                        <DataGridTextColumn Header="ECTS" Binding="{Binding ECTS}" Width="50"/>
                                        <DataGridTextColumn Header="Prowadzący" Binding="{Binding Prowadzacy}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </GroupBox>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="Button_AnulujKierunek_Click" Content="Anuluj" Width="100" Height="30" Margin="5"/>
                    <Button x:Name="Button_ZapiszKierunek_Click" Content="Zapisz Kierunek" Width="100" Height="30" Margin="5" Click="Button_ZapiszKierunek_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>