<Window x:Class="DziennikGUI.OknoDziekanat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel Dziekanatu" Height="650" Width="1100" Background="#FFEAECEF">

    <Grid Margin="15">
        <TabControl Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" BorderThickness="0" Background="Transparent" Padding="12,8" Margin="0,0,5,0" CornerRadius="6,6,0,0">
                                    <ContentPresenter x:Name="ContentSite"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ContentSource="Header"
                                        Margin="10,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#FFFFFFFF" />
                                        <Setter Property="Foreground" Value="Black" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter TargetName="Border" Property="Background" Value="#FFE0E0E0" />
                                        <Setter Property="Foreground" Value="Gray" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Studenci">
                <Border Background="White" CornerRadius="0,6,6,6" Margin="0" Padding="15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Color="#D0D0D0" Direction="270" ShadowDepth="3" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Zarządzanie Studentem" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <Label Content="Imię:"/>
                            <TextBox x:Name="txtImie" Padding="3"/>

                            <Label Content="Nazwisko:"/>
                            <TextBox x:Name="txtNazwisko" Padding="3"/>

                            <Label Content="PESEL:"/>
                            <TextBox x:Name="txtPesel" Padding="3"/>

                            <Button Content="Dodaj Studenta" Click="ButtonDodaj_Click" Margin="0,15" Padding="5" Background="#DDDDDD"/>
                            
                            <Label Content="Wybierz kierunek:" Margin="0,0,0,-15"/>
                            <ComboBox x:Name="cmbKierunkow" Margin="0,15" Padding="5"/>
                            <Button Content="Przypisz do kierunku" Click="ButtonPrzypisz_Cick" Margin="0,15" Padding="5" Background="#DDDDDD"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Raport student" Click="ButtonGenerujRaport_Click" Padding="5" Background="#DDDDDD" Margin="0,0,2,0"/>

                                <Button Grid.Column="1" Content="XML" Click="ButtonRaportXML_Click" Padding="5" Background="#DDDDDD" Margin="2,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <DockPanel Grid.Column="1">
                            <TextBlock DockPanel.Dock="Top" Text="Baza studentów:" FontWeight="SemiBold"/>
                            <ListBox x:Name="listaStudentow" Margin="0,5,0,0"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Prowadzący">
                <Border Background="White" CornerRadius="0,6,6,6" Margin="0" Padding="15">
                     <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Color="#D0D0D0" Direction="270" ShadowDepth="3" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                             <TextBlock Text="Zarządzanie Prowadzącym" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <GroupBox Header="Formularz dodawania" BorderBrush="#D0D0D0" Padding="10">
                                <StackPanel>
                                    <Label Content="Imię:"/>
                                    <TextBox x:Name="txtImieProw" Padding="4"/>

                                    <Label Content="Nazwisko:"/>
                                    <TextBox x:Name="txtNazwiskoProw" Padding="4"/>

                                    <Label Content="PESEL:"/>
                                    <TextBox x:Name="txtPeselProw" Padding="4"/>

                                    <Label Content="Tytuł naukowy:"/>
                                    <ComboBox x:Name="cmbTytulNaukowy" Padding="4"/>

                                    <Button Content="Dodaj Prowadzącego" Click="ButtonDodajProw_Click" Margin="0,15,0,0" Style="{StaticResource BtnSuccess}"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,10">
                               <Button x:Name="btnUsunProw" Content="Usuń" Click="ButtonUsunProw_Click" Width="147" IsEnabled="False" Margin="0,0,10,0" Style="{StaticResource BtnDanger}"/>
                               <Button Content="Zmień sortowanie" Click="ButtonSortujProw_Click" Width="147" Style="{StaticResource BtnSecondary}"/>
                            </StackPanel>

                            <TextBlock Text="Przedmioty wybranego:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                             <Border Background="#F9F9F9" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1" Height="120">
                                <ListBox x:Name="listaPrzedmiotowProwadzacego" Background="Transparent" BorderThickness="0"/>
                             </Border>
                        </StackPanel>

                        <DockPanel Grid.Column="1">
                            <TextBlock DockPanel.Dock="Top" Text="Lista prowadzących" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                             <Border Background="#F9F9F9" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">
                                <ListBox x:Name="listaProwadzacych" SelectionChanged="ListaProwadzacych_SelectionChanged" BorderThickness="0" Background="Transparent"/>
                             </Border>
                        </DockPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Kierunki">
                <Border Background="White" CornerRadius="0,6,6,6" Margin="0" Padding="15">
                     <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Color="#D0D0D0" Direction="270" ShadowDepth="3" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,0,0,15" Padding="0,0,0,10" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kreator Kierunku:" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Label Content="Nazwa:"/>
                                <TextBox Width="300" Margin="5,0" x:Name="txtNazwaKierunku" Padding="4"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock DockPanel.Dock="Top" Text="Szkic Semestrów" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <Button Content="Dodaj kolejny Semestr" DockPanel.Dock="Bottom" Click="ButtonDodajSemestr_Click" Margin="0,10,0,0" Style="{StaticResource BtnPrimary}"/>
                                
                                <Border Background="#F9F9F9" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <ListBox x:Name="listaSemestrow" BorderThickness="0" Background="Transparent">
                                         <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock>
                                                        <Run Text="Rok: " FontWeight="Bold"/>
                                                        <Run Text="{Binding RokAkademicki}"/>
                                                        <Run Text=" ("/>
                                                        <Run Text="{Binding Typ}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </DockPanel>

                            <Border Grid.Column="1" Background="#FDFDFD" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10">
                                <Grid DataContext="{Binding WybranySemestr}"> 
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="Konfiguracja Aktualnego Semestru" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#555"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <Label Content="Rok:" Width="40"/>
                                            <TextBox x:Name="txtRokAkademicki" Width="80" Padding="3"/>
                                            <Label Content="Typ:" Width="40" Margin="10,0,0,0"/>
                                            <ComboBox x:Name="cmbTypSemestru" Width="120" Padding="3"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <GroupBox Grid.Row="1" Header="Dodaj przedmiot" Margin="0,15,0,10" BorderBrush="#D0D0D0">
                                        <StackPanel Margin="5">
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <Label Content="Nazwa:" Width="80"/>
                                                <TextBox x:Name="txtNazwaPrzedmiotu" Width="200" Padding="3"/>
                                            </StackPanel>
                                             <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <Label Content="ECTS:" Width="80"/>
                                                <TextBox x:Name="txtEcts" Width="60" Padding="3"/>
                                            </StackPanel>
                                             <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <Label Content="Prowadzący:" Width="80"/>
                                                <ComboBox x:Name="cmbProwadzacy" Width="200" DisplayMemberPath="Nazwisko" Padding="3"/>
                                            </StackPanel>
                                            <Button Content="Dodaj Przedmiot" Click="ButtonDodajPrzedmiot_Click" HorizontalAlignment="Left" Margin="80,10,0,0" Style="{StaticResource BtnSuccess}" Width="120" Height="24"/>
                                        </StackPanel>
                                    </GroupBox>

                                    <DockPanel Grid.Row="2">
                                        <TextBlock DockPanel.Dock="Top" Text="Przedmioty w tym semestrze:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <ListBox x:Name="listaPrzedmiotow" BorderBrush="#E0E0E0" BorderThickness="1">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Nazwa}" FontWeight="Bold"/>
                                                        <TextBlock Text=" (" Foreground="Gray"/>
                                                        <TextBlock Text="{Binding Ects}" Foreground="Gray"/>
                                                        <TextBlock Text=" ECTS) - " Foreground="Gray"/>
                                                        <TextBlock Text="{Binding Prowadzacy.Nazwisko}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <Button x:Name="btnAnulujKierunek" Content="Anuluj" Width="100" Height="35" Margin="5" Style="{StaticResource BtnSecondary}"/>
                            <Button x:Name="btnZapiszKierunek" Content="Zapisz Cały Kierunek" Width="150" Height="35" Margin="5" Click="Button_ZapiszKierunek_Click" Style="{StaticResource BtnPrimary}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>