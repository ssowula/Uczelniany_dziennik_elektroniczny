<Window x:Class="DziennikGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logowanie - Elektroniczny Dziennik" Height="400" Width="500" 
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <TextBlock Text="System Uczelniany" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#333"/>

            <Label Content="Login / Nr Albumu / Nazwisko:" FontWeight="SemiBold"/>
            <TextBox x:Name="txtLogin" Height="35" Margin="0,0,0,15" Padding="5" FontSize="14"/>

            <Label Content="Hasło / PESEL:" FontWeight="SemiBold"/>
            <PasswordBox x:Name="txtHaslo" Height="35" Margin="0,0,0,25" Padding="5" FontSize="14"/>

            <Button Content="Zaloguj się" Height="45" Background="#007ACC" Foreground="White" 
                    FontSize="16" FontWeight="Bold" Click="BtnZaloguj_Click" TouchEnter="BtnZaloguj_Click"/>

        </StackPanel>
    </Grid>
</Window>