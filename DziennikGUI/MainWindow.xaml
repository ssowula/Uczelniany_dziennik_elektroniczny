<Window x:Class="DziennikGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elektroniczny Dziennik Uczelniany" Height="500" Width="600">

    <TabControl Margin="5">

        <TabItem Header="Studenci">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Nowy Student" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Label Content="Imię:"/>
                    <TextBox x:Name="txtImie" Padding="3"/>

                    <Label Content="Nazwisko:"/>
                    <TextBox x:Name="txtNazwisko" Padding="3"/>

                    <Label Content="PESEL:"/>
                    <TextBox x:Name="txtPesel" Padding="3"/>

                    <Button Content="Dodaj Studenta" Click="ButtonDodaj_Click" Margin="0,15" Padding="5" Background="#DDDDDD"/>
                </StackPanel>

                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Text="Baza studentów:" FontWeight="SemiBold"/>
                    <ListBox x:Name="listaStudentow" Margin="0,5,0,0"/>
                </DockPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Prowadzący">
        </TabItem>

        <TabItem Header="Przedmioty i Oceny">
        </TabItem>

    </TabControl>
</Window>