<Window x:Class="DziennikGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logowanie - Elektroniczny Dziennik" Height="500" Width="400" 
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#FFEAECEF">

    <Grid>
        <Border Background="White" CornerRadius="8" Width="320" Height="400" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Color="#D0D0D0" Direction="270" ShadowDepth="3" Opacity="0.4"/>
            </Border.Effect>
            
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">
                    <TextBlock Text="Dziennik Uczelniany" FontSize="22" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center"/>
                    <TextBlock Text="Zaloguj się do systemu" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Label Content="Login" FontWeight="SemiBold" Foreground="#444"/>
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Background="#FAFAFA" Margin="0,0,0,15">
                        <TextBox x:Name="txtLogin" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>
                    </Border>

                    <Label Content="Hasło" FontWeight="SemiBold" Foreground="#444"/>
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Background="#FAFAFA" Margin="0,0,0,25">
                        <PasswordBox x:Name="txtHaslo" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>
                    </Border>

                    <Button Content="ZALOGUJ SIĘ" Height="40" 
                            Style="{StaticResource BtnPrimary}"
                            Click="BtnZaloguj_Click"/>
                </StackPanel>
                
                <TextBlock Grid.Row="2" Text="© 2026 Uczelnia" FontSize="10" Foreground="LightGray" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>