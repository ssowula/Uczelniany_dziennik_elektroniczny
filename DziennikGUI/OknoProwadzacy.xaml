<Window x:Class="DziennikGUI.OknoProwadzacy"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DziennikGUI"
        mc:Ignorable="d"
        Title="Informacje dla Prowadzącego" Height="600" Width="1000" Background="#FFEAECEF">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Border Background="White" CornerRadius="8" Padding="20 15" Margin="0,0,10,15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Color="#D0D0D0" Direction="270" ShadowDepth="3" Opacity="0.4"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Prowadzący:" FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TytulNaukowy}" FontSize="13" Foreground="#555" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" Margin="0,8,0,12">
                        <Run Text="{Binding Imie}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Nazwisko}"/>
                    </TextBlock>

                    <Separator Background="#E0E0E0" Margin="0,5,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="PESEL: " FontSize="12" Foreground="Gray"/>
                        <TextBlock Text="{Binding Pesel}" FontSize="12" Foreground="#333" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Color="#D0D0D0" Direction="270" ShadowDepth="3" Opacity="0.4"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Twoje Przedmioty" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" Grid.Row="0"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="350">
                        <ListBox x:Name="listaPrzedmiotow" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="listaPrzedmiotow_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F5F5F7" CornerRadius="6" Padding="12" Margin="0,0,0,8" Cursor="Hand" Width="300">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Przedmiot.Nazwa}" FontWeight="Bold" FontSize="14" Foreground="#222"/>
                                            <TextBlock Text="{Binding Kierunek.NazwaKierunku}" FontSize="11" Foreground="Gray" Margin="0,4,0,0"/>
                                            <TextBlock FontSize="11" Foreground="#666" Margin="0,2,0,0">
                                                <Run Text="{Binding Semestr.Typ, Mode=OneWay}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Semestr.RokAkademicki, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>

        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Color="#D0D0D0" Direction="270" ShadowDepth="3" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Szczegóły przedmiotu" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" Grid.Row="0"/>
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="panelDanePrzedmiotu" Grid.Column="0">
                        <TextBlock Text="{Binding Przedmiot.Nazwa}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Margin="0,5,0,0">
                            <Run Text="Kierunek: "/>
                            <Run Text="{Binding Kierunek.NazwaKierunku, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Semestr: "/>
                            <Run Text="{Binding Semestr.Typ, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding Semestr.RokAkademicki, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock>
                            <Run Text="ECTS: "/>
                            <Run Text="{Binding Przedmiot.Ects, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button x:Name="btnDodajOcene" Content="Dodaj ocenę" Margin="0,0,0,5" Width="100" Height="24" IsEnabled="False" Click="btnDodajOcene_Click" Style="{StaticResource BtnPrimary}"/>
                        <Button x:Name="btnEdytujOcene" Content="Edytuj Ocenę" Width="100" Height="24" IsEnabled="False" Click="btnEdytuj_Ocene" Style="{StaticResource BtnSecondary}"/>
                    </StackPanel>
                </Grid>


                <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Lista studentów" FontWeight="SemiBold" Margin="0,0,0,10" Grid.Row="0"/>

                        <DataGrid x:Name="listaStudentow" Grid.Row="1" 
                            AutoGenerateColumns="False" 
                            IsReadOnly="True"
                            HeadersVisibility="Column"
                            GridLinesVisibility="Horizontal"
                            BorderThickness="0"
                            Background="Transparent"
                            SelectionChanged="listaStudentow_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Student" Binding="{Binding ImieNazwisko}" Width="*"/>
                                <DataGridTextColumn Header="Indeks" Binding="{Binding NumerAlbumu}" Width="80"/>
                                <DataGridTextColumn Header="Oceny" Binding="{Binding Oceny}" Width="200"/>
                                <DataGridTextColumn Header="Średnia" Binding="{Binding Srednia, StringFormat='{}{0:F2}'}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
