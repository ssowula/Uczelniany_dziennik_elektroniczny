<Window x:Class="DziennikGUI.OknoZarzadzaniaOcenami"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarządzaj ocenami" Height="300" Width="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Zarządzanie ocenami" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtStudent" Text="Student: Jan Kowalski" Foreground="Gray"/>
            <TextBlock x:Name="txtPrzedmiot" Text="Przedmiot: Matematyka" Foreground="Gray"/>
        </StackPanel>

        <GroupBox Header="Lista ocen" Grid.Row="1">
            <ListBox x:Name="listaOcen" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Wartosc}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text=" (dodano: " Foreground="Gray" FontSize="10" VerticalAlignment="Bottom" Margin="5,0,0,1"/>
                                <TextBlock Text="{Binding DataWystawienia, StringFormat=d}" Foreground="Gray" FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                <TextBlock Text=")" Foreground="Gray" FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="btnUsun" Content="Usuń zaznaczoną ocenę" Padding="10,5" Click="btnUsun_Click"/>
            <Button Content="Zamknij" Margin="0,5,0,0" Padding="10,5" Click="btnZamknij_Click"/>
        </StackPanel>
    </Grid>
</Window>
