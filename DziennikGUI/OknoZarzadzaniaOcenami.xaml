<Window x:Class="DziennikGUI.OknoZarzadzaniaOcenami"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarządzaj ocenami" Height="350" Width="350" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FFEAECEF">
    <Grid Margin="15">
        <Border Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Color="#D0D0D0" Direction="270" ShadowDepth="3" Opacity="0.4"/>
            </Border.Effect>
            
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Zarządzanie ocenami" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtStudent" Text="Student: Jan Kowalski" Foreground="#333" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtPrzedmiot" Text="Przedmiot: Matematyka" Foreground="Gray" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#F9F9F9" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1">
                    <ListBox x:Name="listaOcen" BorderThickness="0" Background="Transparent" Padding="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Wartosc}" FontWeight="Bold" FontSize="14" Foreground="#333"/>
                                        <TextBlock Text=" (" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        <TextBlock Text="{Binding DataWystawienia, StringFormat=d}" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text=")" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,20,0,0" Orientation="Vertical">
                    <Button x:Name="btnUsun" Content="Usuń zaznaczoną ocenę" Style="{StaticResource BtnDanger}" Width="200" Height="24" Click="btnUsun_Click"/>
                    <Button Content="Zamknij" Style="{StaticResource BtnSecondary}" Width="200" Height="24" Margin="0,10,0,0" Click="btnZamknij_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
